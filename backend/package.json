{
  "name": "forca-dev-backend",
  "version": "1.0.0",
  "description": "API do Forca Dev: jogo da forca com termos de programação",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "tsx src/database/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@prisma/client": "6.19.3",
    "fastify": "^5.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
